# ── App ──────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ── Neo4j ────────────────────
NEO4J_URI=bolt://localhost:7687
